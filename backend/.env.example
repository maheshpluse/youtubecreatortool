# Copy to .env and fill in. .env is gitignored; this template is not.

# Anthropic key used by every AI endpoint. Optional if you set the key from the
# admin panel instead (Firestore: app_settings/api_keys.anthropic_api_key),
# which takes precedence over this value.
ANTHROPIC_API_KEY=sk-ant-...

# Server-side reCAPTCHA secret, paired with the site key in
# frontend/web/index.html. Required in production.
RECAPTCHA_SECRET_KEY=

# Local development only. When true AND RECAPTCHA_SECRET_KEY is empty, the API
# skips reCAPTCHA verification entirely. Never enable this in production: every
# endpoint below bills a real Anthropic key.
ALLOW_INSECURE_RECAPTCHA=true

# Comma-separated browser origins allowed to call this API. Needs to include
# wherever admin_panel's dev server runs (Vite defaults to :5173) for the
# Admins page to reach /api/admin/*.
# Defaults to http://localhost:8080,http://127.0.0.1:8080 (+ :8082, :5173, vidseokit.com) when unset.
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
