[Unit]
Description=VidSEOKit FastAPI Backend
After=network.target

[Service]
User=root
Group=www-data
WorkingDirectory=/var/www/vidseokit/backend
Environment="PATH=/var/www/vidseokit/backend/venv/bin"
ExecStart=/var/www/vidseokit/backend/venv/bin/uvicorn main:app --host 127.0.0.1 --port 8000

[Install]
WantedBy=multi-user.target
